+                        } finally { NDD.deref(care); }
+                    }
+                    if (groupIndex + 1 < groups.size()) {
+                        prior = manager.orDerefBoth(prior, inner); inner = 0;
+                    }
+                } finally { NDD.deref(inner); }
+            }
+            return result;
+        } catch (RuntimeException | Error failure) {
+            for (int root : result.values()) NDD.deref(root); throw failure;
+        } finally { NDD.deref(prior); }
+    }
