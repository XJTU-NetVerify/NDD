+                            int ruleRegion = NDD.ref(NDD.and(care, rule.getListTC()));
+                            int bounded;
+                            try { bounded = NDD.ref(rule.isBudgetBounded(budget) ? ruleRegion : NDD.and(ruleRegion, budget)); }
+                            finally { NDD.deref(ruleRegion); }
+                            try {
