+    private HashMap<PortName, Integer> clippedPortPredicates(NDDSortedMultiList rules, boolean ecmp, int fwd) {
+        HashMap<PortName, Integer> result = new HashMap<>();
+        int budget = manager.FILTER_BDD, prior = 0;
+        ArrayList<ArrayList<NDDSortedMultiListItem>> groups;
+        if (ecmp) groups = rules;
+        else {
+            groups = new ArrayList<>();
+            for (NDDSortedMultiListItem item : rules.flat()) {
+                ArrayList<NDDSortedMultiListItem> group = new ArrayList<>(1); group.add(item); groups.add(group);
+            }
+        }
+        try {
+            for (int groupIndex = 0; groupIndex < groups.size(); ++groupIndex) {
+                if (prior == budget) break;
+                int inner = 0;
+                try {
+                    for (NDDSortedMultiListItem item : groups.get(groupIndex)) {
+                        NDDForwardingRule rule = (NDDForwardingRule)item;
+                        Prefix prefix = rule.getPrefix();
+                        int dst = manager.nddACLWrapper.encodeDstIPPrefix(prefix.getIp().asLong(), prefix.getPreLength());
+                        int care = NDD.ref(NDD.and(fwd, dst));
+                        try {
